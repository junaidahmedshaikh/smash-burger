{
  "name": "smashd-craft-burgers-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready premium burger e-commerce platform inspired by modern editorial food aesthetics",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@smashd/web",
    "dev:api": "npm run dev --workspace=@smashd/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@smashd/web",
    "build:api": "npm run build --workspace=@smashd/api",
    "seed": "npm run seed --workspace=@smashd/api",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
